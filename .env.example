# Local demo. scripts/init_env.py generates local passwords/tokens.
RUN_MODE=demo
POSTGRES_IMAGE=postgres:17-alpine
GRAFANA_IMAGE=grafana/grafana:12.2.0
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
# Disable the local-model profile when using your existing internal model server.
COMPOSE_PROFILES=local-model
OLLAMA_IMAGE=ollama/ollama:0.40.2
OLLAMA_PORT=11434
POSTGRES_PASSWORD=local-demo-change-me
GRAFANA_DB_PASSWORD=local-demo-change-me
GRAFANA_ADMIN_PASSWORD=local-demo-change-me
API_TOKEN=local-demo-change-me
API_PORT=8000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
SIMULATOR_PORT=9100
# Full metrics API base: include /select/TENANT/prometheus for clustered VictoriaMetrics.
METRICS_BASE_URL=http://prometheus:9090
METRICS_TOKEN=
RULES_QUERY_URL=http://prometheus:9090/api/v1/rules
LOGS_QUERY_URL=http://simulator:9100/select/logsql/query
LOGS_BACKEND=victorialogs
# Loki uses a full /loki/api/v1/query_range URL and optional X-Scope-OrgID.
LOGS_TENANT_ID=
LOG_SCOPE_FIELDS=service,environment,cluster,namespace,workload
LOGS_TOKEN=
LOGS_ACCOUNT_ID=0
LOGS_PROJECT_ID=0
# Native Ollama schema-constrained API. Model tag is also used by model-pull.
# For the work model set MODEL_API=openai and its full /v1/chat/completions URL.
MODEL_API=ollama
MODEL_CHAT_URL=http://ollama:11434/api/chat
MODEL_NAME=qwen3:1.7b
MODEL_TOKEN=
MODEL_CONTEXT_TOKENS=16384
MODEL_OUTPUT_TOKENS=2048
MODEL_INPUT_CHARS=32000
MODEL_TIMEOUT_SECONDS=300
QUERIES_FILE=/app/config/queries.json
GRAFANA_METRICS_URL=http://prometheus:9090
LABEL_MAP={}
LOG_FIELD_MAP={}
PROMETHEUS_SCRAPE_TARGET=simulator:9100
ALERTMANAGER_TARGET=alertmanager:9093
ANALYSIS_WEBHOOK_URL=http://api:8000/webhooks/alertmanager
SCRAPE_INTERVAL=5s
DEMO_RULE_FOR=15s
HISTORY_HOURS=24
REVIEW_INTERVAL_SECONDS=3600
JOB_LEASE_SECONDS=600
